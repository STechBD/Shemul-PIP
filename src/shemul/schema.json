{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Shemul Config",
	"type": "object",
	"required": ["commands"],
	"properties": {
		"$schema": { "type": "string" },
		"name": { "type": "string" },
		"version": { "type": "string" },
		"runtime": { "type": "string" },
		"requires": { "type": "string" },
		"update_check": { "type": "boolean" },
		"env": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"additionalProperties": true
			}
		},
		"vars": {
			"type": "object",
			"additionalProperties": { "type": ["string", "number", "boolean"] }
		},
		"bin": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"additionalProperties": { "type": "string" }
			}
		},
		"commands": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {
				"type": "object",
				"required": ["run"],
				"properties": {
					"run": { "type": "string" },
					"desc": { "type": "string" },
					"env": { "type": "string" },
					"group": { "type": "string" },
					"confirm": { "type": "boolean" },
					"danger": { "type": "boolean" },
					"shell": { "type": ["string", "boolean"] },
					"exec": {
						"type": "array",
						"items": { "type": "string" }
					},
					"os": {
						"type": "object",
						"additionalProperties": { "type": "string" }
					},
					"needs": {
						"type": "array",
						"items": { "type": "string" }
					},
					"pre": {
						"type": "array",
						"items": { "type": "string" }
					},
					"post": {
						"type": "array",
						"items": { "type": "string" }
					},
					"parallel": { "type": "boolean" },
					"runner": { "type": "string" }
				},
				"additionalProperties": false
			}
		}
	},
	"additionalProperties": false
}
